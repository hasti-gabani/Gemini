# Copy to .env (project root or backend/) and adjust. Every value is optional.
# To put the app on the internet, run `python scripts/runner.py online-env <your-domain>` instead:
# it writes a .env with the right values (README: "Putting the app online").

# --- Security -------------------------------------------------------------
# Leave empty to auto-generate one (stored in backend/.secret_key). Keep it secret: changing it
# signs everyone out and breaks bill links already shared.
SECRET_KEY=
# Always False on a real server.
DEBUG=False
# Host names / IPs the app is reached at, comma separated.
# `python scripts/runner.py serve` adds this PC's Wi-Fi IP automatically.
ALLOWED_HOSTS=localhost,127.0.0.1
# Needed only when served over HTTPS on a public domain, e.g. https://billing.example.com
CSRF_TRUSTED_ORIGINS=
# True when the app is reached over HTTPS (behind Caddy / nginx / Cloudflare): turns on the HTTP -> HTTPS
# redirect, HSTS for 1 year and secure cookies. Bluetooth printing needs HTTPS on phones.
USE_HTTPS=False
# With USE_HTTPS=True these default to the safe values below; change them only if you know why.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# Behind a reverse proxy: read the visitor's address from X-Forwarded-For (used by the sign-in lockout).
USE_X_FORWARDED_FOR=False
# The Django admin is off unless this is set to a hard-to-guess path, e.g. manage-7f3k9q/
ADMIN_URL=

# --- Sign-in ----------------------------------------------------------------
# Wrong passwords before a user is locked, and for how many minutes.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Wrong passwords from one address (any user name) before that address is locked.
LOGIN_MAX_FAILURES_PER_ADDRESS=20
# Automatic sign-out: after this many minutes without using the app, and this many hours after signing in.
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
# Nobody can sign up from the login page. Set True only while creating the first business on a new
# server, then back to False.
ALLOW_REGISTRATION=False
AUTH_THROTTLE_RATE=20/min

# --- Data -----------------------------------------------------------------
# Default: SQLite at backend/db.sqlite3. PostgreSQL example:
# DATABASE_URL=postgres://user:password@localhost:5432/tallin
DATABASE_URL=
# Where uploaded logos, item photos, payment proofs and backups are stored.
MEDIA_ROOT=
TIME_ZONE=Asia/Kolkata

# --- Backups ----------------------------------------------------------------
# One automatic backup per business per day while the app runs (MEDIA_ROOT/backups), kept this many days.
# The copy to a Google Drive folder is set in Settings -> Backup & Restore.
AUTO_BACKUP_ENABLED=True
AUTO_BACKUP_KEEP_DAYS=30
# How often (minutes) the app checks whether today's backup is done.
AUTO_BACKUP_CHECK_MINUTES=30

# --- App --------------------------------------------------------------------
APP_NAME=Gemini
# Address customers can open, used in shared bill links (e.g. https://billing.example.com).
# Leave empty to use the address you opened the app with.
PUBLIC_BASE_URL=
MAX_UPLOAD_MB=10
MAX_RESTORE_MB=500
LOG_LEVEL=INFO

# --- WhatsApp: send bill PDFs straight to the party's number (WhatsApp Business Cloud API) ---
# Leave empty to keep the normal Share options only. Steps: see WHATSAPP_SETUP.md.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=invoice_pdf
# WHATSAPP_TEMPLATE_LANGUAGE=en
# Template body variables {{1}}, {{2}}, ... in order: party, number, amount, balance, date, business
# WHATSAPP_TEMPLATE_PARAMS=party,number,amount
